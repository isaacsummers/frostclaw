#!/usr/bin/env bash
set -euo pipefail

# OpenClaw post-update script
# Run after `openclaw update --no-restart` to rebuild frostclaw and bring the gateway back up.
# Handles: frostclaw rebuild, gateway service refresh, embed proxy restart, doctor verification.

FROSTCLAW_DIR="${FROSTCLAW_DIR:-$HOME/projects/frostclaw}"
GATEWAY_SVC="$HOME/.config/systemd/user/openclaw-gateway.service"

OPENCLAW_BIN="$(command -v openclaw)"

if [ ! -x "$OPENCLAW_BIN" ]; then
  echo "  ❌ openclaw binary not found at $OPENCLAW_BIN — aborting" >&2
  exit 1
fi

echo "==> Using openclaw: $OPENCLAW_BIN"

# Stop the gateway first — before any file replacements happen.
echo "==> Stopping openclaw gateway service..."
systemctl --user stop openclaw-gateway.service 2>/dev/null || true

# Rebuild frostclaw BEFORE gateway install/start so dist/index.js is fresh.
if [ -d "$FROSTCLAW_DIR" ]; then
  echo "==> Rebuilding frostclaw plugin..."
  cd "$FROSTCLAW_DIR"

  bun install
  bun run build

  echo "==> Frostclaw rebuilt successfully"
else
  echo "==> Frostclaw not found at $FROSTCLAW_DIR, skipping plugin rebuild"
fi

if [ -f "$GATEWAY_SVC" ]; then
  "$OPENCLAW_BIN" gateway install --force || {
    echo "  ❌ openclaw gateway install failed" >&2
    exit 1
  }

  systemctl --user daemon-reload 2>/dev/null || true
  systemctl --user start openclaw-gateway.service 2>/dev/null && \
    echo "  ✅ openclaw-gateway.service started" || \
    echo "  ⚠️  could not start openclaw-gateway.service"
fi

if [ -d "$FROSTCLAW_DIR" ]; then
  echo "==> Restarting unified Snowflake proxy..."
  systemctl --user restart snowflake-proxy 2>/dev/null || true
fi

# Run doctor now that the gateway is up with the freshly built plugin.
# (openclaw update --no-restart ran doctor before the restart, so this verifies
# the full post-restart state including frostclaw loading correctly.)
echo "==> Running openclaw doctor..."
"$OPENCLAW_BIN" doctor --non-interactive || true
