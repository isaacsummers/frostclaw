  "description": "Snowflake Cortex AI provider \u2014 routes Claude models to the Anthropic Messages API and all others to Chat Completions. PAT auth.",
  "providers": [
    "snowflake-cortex"
  ],
  "activation": {
    "onStartup": true
  },
  "modelCatalog": {
    "providers": {
      "snowflake-cortex": {
        "models": [
          {
            "id": "claude-opus-4-7",
            "compat": {
              "supportedReasoningEfforts": [
                "off",
                "adaptive"
              ]
            }
          },
          {
            "id": "claude-opus-4-6",
            "compat": {
              "supportedReasoningEfforts": [
                "off",
                "adaptive"
              ]
            }
          },
          {
            "id": "claude-opus-4-5",
            "compat": {
              "supportedReasoningEfforts": [
                "off",
                "adaptive"
              ]
            }
          },
          {
            "id": "claude-sonnet-4-6",
            "compat": {
              "supportedReasoningEfforts": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "adaptive"
              ]
            }
          },
          {
            "id": "claude-sonnet-4-5",
            "compat": {
              "supportedReasoningEfforts": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "adaptive"
              ]
            }
          }
        ]
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "snowflake-cortex",
        "envVars": [
          "SNOWFLAKE_PAT",
          "SNOWFLAKE_CORTEX_API_KEY",
          "SNOWFLAKE_BASE_URL"
        ]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "snowflake-cortex",
      "method": "api-key",
      "choiceId": "snowflake-cortex-pat",
      "choiceLabel": "Snowflake PAT",
      "groupId": "snowflake-cortex",
      "groupLabel": "Snowflake Cortex",
      "cliFlag": "--snowflake-pat",
      "cliOption": "--snowflake-pat <token>",
      "cliDescription": "Snowflake Programmatic Access Token"
    }
  ],
  "contracts": {
    "memoryEmbeddingProviders": [
      "snowflake-cortex"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  }
