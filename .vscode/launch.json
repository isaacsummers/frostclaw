{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run tests",
      "runtimeExecutable": "/home/ubuntu/.local/share/mise/installs/bun/latest/bin/bun",
      "runtimeArgs": ["test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run tests (watch)",
      "runtimeExecutable": "/home/ubuntu/.local/share/mise/installs/bun/latest/bin/bun",
      "runtimeArgs": ["test", "--watch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
